// Gulf Seismic — data models
// Production: PostgreSQL (Neon). Local dev: also PostgreSQL via DATABASE_URL env.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rfq {
  id            String   @id @default(cuid())
  // Contact
  name          String
  company       String?
  role          String?
  email         String
  phone         String?
  country       String?
  city          String?
  // Project
  projectName   String?
  clientType    String?  // consultant / contractor / EPC / facility owner / government / other
  service       String?
  quantity      String?
  surface       String?  // surface type / condition
  completionDate String?
  procurementStage String? // budgeting / tendering / award / mobilization
  saudiRoute    String?  // direct / partner-led / project-specific / unsure
  preferredContact String? // email / phone / whatsapp
  message       String?
  // File uploads (metadata only — we store references, not binaries, in this prototype)
  attachments   String?  @default("[]") // JSON array of {name, size, type, dataUrl?}
  // Classification
  leadGrade     String?  // A / B / C
  leadScore     Int?     @default(0)
  status        String   @default("new") // new / contacted / quoted / proposal / won / lost
  source        String?  // home / services / contact / assistant
  // AI
  aiSummary     String?
  // Consent
  consent       Boolean  @default(false)
  // Meta
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([leadGrade])
  @@index([createdAt])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  country   String?
  city      String?
  service   String?
  message   String?
  grade     String?  // A / B / C
  leadScore Int?     @default(0)  // 0-100 computed score
  status    String   @default("new") // new / contacted / quoted / proposal / won / lost
  source    String?  // website-rfq / whatsapp / call / contact / tender
  campaign  String?
  funnel    String?  @default("rfq")
  notes     String?
  userAgent String?
  referrer  String?
  pagePath  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([country])
  @@index([city])
  @@index([service])
  @@index([createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  lang      String   @default("en")
  createdAt DateTime @default(now())
}

model CaseStudy {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  category    String?  // verified-project / capability-example
  clientType  String?
  location    String?
  challenge   String?
  scope       String?
  solution    String?
  materials   String?
  equipment   String?
  result      String?
  image       String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  icon      String?
  published Boolean  @default(true)
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  meta      String?  // JSON
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Admin — authentication + content management
// ---------------------------------------------------------------------------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("editor") // admin | editor | viewer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProjectRecord {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  country     String
  city        String?
  service     String?
  industry    String?
  client      String?
  year        Int?
  duration    String?
  location    String?
  area        String?
  challenge   String?
  solution    String?
  execution   String?
  materials   String?  // JSON array
  equipment   String?  // JSON array
  results     String?  // JSON array of {label,value}
  status      String   @default("published") // draft | published
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([country])
  @@index([city])
  @@index([service])
  @@index([status])
}

model CaseStudyRecord {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  projectSlug        String?
  summary            String
  outcomes           String?  // JSON array
  testimonialQuote   String?
  testimonialAuthor  String?
  testimonialRole    String?
  status             String   @default("published") // draft | published
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Full CMS — pages, posts, menus, hero, site settings
// ---------------------------------------------------------------------------

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  heroHeading     String?
  heroDescription String?
  heroEyebrow     String?
  content         String   // Markdown / HTML body
  excerpt         String?
  seoTitle        String?
  seoDescription  String?
  status          String   @default("published") // draft | published
  showInHeader    Boolean  @default(false)
  showInFooter    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([showInHeader])
  @@index([showInFooter])
}

model Post {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String?
  content        String   // Markdown body
  category       String?
  tags           String?  // JSON array
  author         String?
  featuredImage  String?
  seoTitle       String?
  seoDescription String?
  status         String   @default("published") // draft | published
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([publishedAt])
}

model MenuItem {
  id        String  @id @default(cuid())
  label     String
  url       String
  location  String  @default("header") // header | footer | mobile
  parentId  String?
  order     Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location])
  @@index([order])
}

model HeroSection {
  id           String   @id @default(cuid())
  page         String   @default("home") // home | about | contact | <slug>
  eyebrow      String?
  heading      String
  subheading   String?
  ctaLabel     String?
  ctaUrl       String?
  cta2Label    String?
  cta2Url      String?
  backgroundImage String?
  stats        String?  // JSON array of {label, value}
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([page])
}

model SiteSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String   // JSON-encoded value
  updatedAt       DateTime @updatedAt
}

model Section {
  id        String   @id @default(cuid())
  page      String   // home | about | <slug>
  type      String   // stats | features | cta | testimonial | text | image | gallery
  heading   String?
  subheading String?
  content   String?  // JSON: depends on type
  order     Int      @default(0)
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page])
  @@index([status])
}
